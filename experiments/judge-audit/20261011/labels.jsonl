y list alongside Duke-NUS in Singapore.", "judge_sufficient": true, "judge_supported": true, "human_sufficient": null, "human_supported": null, "notes": "", "corpus": "dku", "source_run": "experiments/output/20261010T203115/eval_guided/traces", "sample_stratum": "accepted", "item": 38}
